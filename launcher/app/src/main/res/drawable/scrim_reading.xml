<?xml version="1.0" encoding="utf-8"?>
<!--
  Reading scrim for the header over a wallpaper.

  The wallpapers are photographs and several of them are bright where the clock sits (a pale sky),
  where thin white text loses contrast. This is a soft vignette anchored on the header's corner:
  densest behind the greeting and date, gone by the middle of the screen so the photograph still
  reads. Drawn once as a static drawable — no per-frame cost.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0.10"
        android:centerY="0.08"
        android:gradientRadius="72%p"
        android:startColor="#C0000000"
        android:centerColor="#5A000000"
        android:endColor="#00000000" />
</shape>
