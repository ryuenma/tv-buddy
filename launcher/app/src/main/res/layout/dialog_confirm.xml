<?xml version="1.0" encoding="utf-8"?>
<!-- Two-button confirmation (the restart button). The safe answer, No, is the one that gets focus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp"
    android:elevation="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="-0.01" />

    <TextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#D9FFFFFF"
        android:textSize="15sp"
        android:lineSpacingExtra="3sp"
        android:fontFamily="@font/outfit" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnNo"
            style="@style/TopButton"
            android:text="@string/no"
            android:nextFocusUp="@+id/btnNo"
            android:nextFocusDown="@+id/btnNo"
            android:nextFocusLeft="@+id/btnNo"
            android:nextFocusRight="@+id/btnYes" />

        <TextView
            android:id="@+id/btnYes"
            style="@style/TopButton"
            android:text="@string/yes"
            android:nextFocusUp="@+id/btnYes"
            android:nextFocusDown="@+id/btnYes"
            android:nextFocusLeft="@+id/btnNo"
            android:nextFocusRight="@+id/btnYes" />
    </LinearLayout>
</LinearLayout>
